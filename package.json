{
  "name": "geora-globe",
  "version": "0.1.0",
  "description": "Framework-agnostic halftone globe: a Three.js web component with themes, layers, markers and modeled analytics.",
  "license": "MIT",
  "author": "Lei Gabriel",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/index.js",
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/index.mjs"
  ],
  "keywords": [
    "globe",
    "three.js",
    "web-component",
    "custom-element",
    "data-visualization",
    "visualization",
    "map",
    "halftone",
    "dots"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leigabriel/geora.git"
  },
  "homepage": "https://github.com/leigabriel/geora#readme",
  "bugs": {
    "url": "https://github.com/leigabriel/geora/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.js",
    "build:demo": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/cache-assets.mjs",
    "landmarks": "node scripts/cache-landmarks.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "three": "^0.128.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tone": "^14.8.49",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  }
}
